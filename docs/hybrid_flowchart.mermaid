flowchart TD
    U["Yêu cầu của HR / ứng viên"] --> Q{"Cần dữ liệu hồ sơ hoặc lịch thực tế?"}
    Q -- "Không" --> C["Chatbot baseline: tư vấn chung"]
    Q -- "Có" --> A["ReAct Agent"]
    A --> P["Tra hồ sơ ẩn danh"]
    P --> E["Đánh giá theo kỹ năng & kinh nghiệm"]
    E --> R{"PASS và ứng viên đã đồng ý?"}
    R -- "Không" --> H["Đề nghị HR kiểm tra / phản hồi"]
    R -- "Có" --> S["Tra slot còn trống"]
    S --> B["Đặt lịch mô phỏng"]
    B --> H
