# =============================================================================
# ⚙️ CẤU HÌNH MULTI-PROVIDER LLM ADAPTER
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN NHÀ CUNG CẤP AI (LLM_PROVIDER)
# Chọn 1 trong các giá trị sau: gemini | openai | anthropic | openrouter | mock
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: ĐIỀN API KEY CHO PROVIDER ĐÃ CHỌN Ở BƯỚC 1
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: (TÙY CHỌN) GHI ĐÈ TÊN MODEL CỤ THỂ (LLM_MODEL)
# 
# 💡 Mặc định nếu ĐỂ TRỐNG (LLM_MODEL=), hệ thống tự dùng Model chuẩn của Provider:
#   - Nếu chọn LLM_PROVIDER=gemini     ➔ Mặc định dùng: gemini-2.5-flash
#   - Nếu chọn LLM_PROVIDER=openai     ➔ Mặc định dùng: gpt-4o-mini
#   - Nếu chọn LLM_PROVIDER=anthropic  ➔ Mặc định dùng: claude-3-haiku-20240307
#   - Nếu chọn LLM_PROVIDER=openrouter ➔ Mặc định dùng: google/gemini-2.5-flash
#
# ✏️ Ví dụ nếu muốn ĐỔI MODEL KHÁC (Điền tên Model cụ thể vào sau dấu =):
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# -----------------------------------------------------------------------------
LLM_MODEL=
